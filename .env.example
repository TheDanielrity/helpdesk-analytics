# Copiar a .env; las variables del proceso tienen prioridad.
SQL_SERVER=localhost
# Usar master para diagnóstico antes de crear la base.
SQL_DATABASE=HelpDeskAnalytics
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH=sql
SQL_ENCRYPT=yes
# Desarrollo local autorizado. En otros entornos usar certificado confiable y no.
SQL_TRUST_SERVER_CERTIFICATE=yes
# Completar sólo en .env local; nunca versionar secretos.
SQL_USER=
SQL_PASSWORD=
